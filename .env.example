# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=app
DATABASE_URL=postgres://app:cambiar_esto@localhost:5432/app?sslmode=disable
DATABASE_URL_TEST=postgres://app:cambiar_esto@localhost:5432/app_test?sslmode=disable

# Backend
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sesión (backend: platform/config y platform/session — T216; el compose los
# inyecta tal cual, T205).
# SESSION_SECRET: secreto para firmar la cookie CSRF — GENERA UNO ALEATORIO,
# por ejemplo con `openssl rand -base64 48`. Debe tener al menos 32 caracteres.
# En producción es OBLIGATORIO: el arranque falla si falta o es corto. En
# desarrollo un valor vacío/corto permite arrancar pero AVISA y degrada la firma
# del CSRF (nunca lo dejes así en un despliegue).
SESSION_SECRET=generar_un_valor_aleatorio_largo_y_unico
# false en desarrollo (panel por HTTP); en un despliegue con HTTPS → true.
SESSION_COOKIE_SECURE=false
# Vida de sesión en minutos (P9): 30 de inactividad y 60 absoluta desde el login.
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_MINUTES=60
# Token de inicialización única del administrador (backend: service_auth,
# cabecera X-Setup-Token en POST /api/v1/setup/initialize — FR-007). GENERA UNO
# ALEATORIO, por ejemplo con `openssl rand -base64 32`, y guárdalo solo para
# la inicialización.
BOOTSTRAP_TOKEN=cambiar_esto

# Redis (backend: compose lo inyecta como REDIS_URL=redis://redis:6379/0, T205;
# REDIS_URL aquí solo se usa fuera de Docker — tests/scripts contra localhost).
REDIS_URL=redis://localhost:6379/0

# Puertos del host (opcionales; docker-compose usa ${VAR:-defecto}, T026).
# Útiles si el puerto local ya está ocupado, p. ej.: DB_PORT=5433 make up
DB_PORT=5432
REDIS_PORT=6379
WEB_PORT=5173

# Frontend
VITE_API_URL=http://localhost:8080
