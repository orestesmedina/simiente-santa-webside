#!/usr/bin/env bash
# Hook de git pre-commit: se ejecuta en cada commit, lo haga un humano, Claude Code, Codex u OpenCode.
# Instalar con: make install-hooks   (configura core.hooksPath=.githooks)
set -uo pipefail

ERRORES=0
fallar() { echo "✗ $1" >&2; ERRORES=1; }

# 0. Los controles necesitan python3. Si no está, casi siempre es git de Windows (VS Code abierto fuera de WSL).
if ! python3 -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
  echo "✗ No se encontró python3 (3.9 o superior), que necesitan los controles del proyecto." >&2
  echo "  Si usas Windows: estás haciendo el commit desde Windows y no desde Ubuntu (WSL)." >&2
  echo "  En VS Code, instala la extensión WSL y abre el proyecto con 'code .' desde la terminal de Ubuntu" >&2
  echo "  (abajo a la izquierda debe decir 'WSL: Ubuntu'). Detalle: $(bash scripts/ruta-kit.sh 2>/dev/null || echo .bowser-spec-kit-ai)/docs/windows-wsl.md" >&2
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
# Un commit que solo elimina archivos también pasa por los controles (migraciones, constitución, perfil).
[ -z "$(git diff --cached --name-only)" ] && exit 0

# 1. Nunca subir secretos
while IFS= read -r f; do
  case "$f" in
    .env|*/.env|.env.*|*/.env.*)
      [[ "$f" == *.env.example ]] || fallar "No se permite commitear '$f' (puede contener secretos)." ;;
    *.pem|*.key|secrets/*) fallar "No se permite commitear '$f' (posible secreto)." ;;
  esac
done <<< "$STAGED"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 || fallar "gitleaks detectó posibles secretos. Revisa con: gitleaks protect --staged -v"
fi

# 2. Kit compartido: los archivos que vienen del submódulo del kit deben coincidir con él
KIT_OK=0
if [ -f .kit-manifest.json ]; then
  RUTA_KIT=$(bash scripts/ruta-kit.sh)
  if [ ! -f "$RUTA_KIT/scripts/instalar_kit.py" ]; then
    fallar "El submódulo $RUTA_KIT/ no está inicializado. Ejecuta: git submodule update --init"
  elif python3 "$RUTA_KIT/scripts/instalar_kit.py" --verificar >/dev/null 2>&1; then
    KIT_OK=1
  else
    fallar "Los archivos del kit no coinciden con $RUTA_KIT/ (editados a mano o sin instalar). Detalle: make check-kit"
  fi
fi

# 3. La constitución solo cambia con aprobación explícita. Tiene dos fuentes: los principios, que son del kit, y
#    las reglas, que son del proyecto (agregarlas por primera vez está permitido). El archivo que leen los agentes
#    (.specify/memory/constitution.md) se genera con las dos, y el control 7 comprueba que esté al día.
#    Los principios que llegan por una actualización del kit (el kit los gestiona y coinciden con él) ya fueron
#    aprobados en el repositorio del kit. Si el proyecto los excluyó (kit.excluir), son suyos y requieren la aprobación.
# Las confirmaciones de una persona. Los nombres anteriores (en español) se siguen aceptando.
APPROVED_CONSTITUTION="${APPROVED_CONSTITUTION:-${APROBADO_CONSTITUCION:-}}"
APPROVED_COSTS="${APPROVED_COSTS:-${APROBADO_COSTOS:-}}"
PRINCIPIOS="equipo/principios.md"
REGLAS="equipo/reglas.md"
if [ "${APPROVED_CONSTITUTION:-}" != "1" ]; then
  CAMBIADOS=$(git diff --cached --name-only --diff-filter=MRD)
  if echo "$CAMBIADOS" | grep -qx "$REGLAS"; then
    fallar "La constitución cambió: las reglas del proyecto ($REGLAS). Requiere aprobación de la dirección técnica: APPROVED_CONSTITUTION=1 git commit ..."
  fi
  if echo "$CAMBIADOS" | grep -qx "$PRINCIPIOS"; then
    if [ "$KIT_OK" != "1" ] || ! python3 -c "import json, sys; sys.exit(0 if sys.argv[1] in json.load(open('.kit-manifest.json')).get('archivos', {}) else 1)" "$PRINCIPIOS" 2>/dev/null; then
      fallar "La constitución cambió: los principios ($PRINCIPIOS). Requiere aprobación de la dirección técnica: APPROVED_CONSTITUTION=1 git commit ..."
    fi
  fi
fi

# 4-6. El perfil: el proyecto declara qué archivos no se modifican y cómo se comprueba el formato de cada parte.
#      Un cambio en el perfil lo confirma una persona (APPROVED_PROFILE=1). Sin perfil no hay nada que revisar.
python3 scripts/verbos.py --pre-commit || ERRORES=1

# 7. Archivos generados al día
FUENTE=$(echo "$STAGED" | grep -E '^(AGENTS\.md|equipo/|\.agents/skills/|CLAUDE\.md|\.claude/|\.codex/|\.opencode/|opencode\.json|\.specify/memory/constitution\.md)' || true)
if [ -n "$FUENTE" ]; then
  python3 scripts/sincronizar.py --verificar >/dev/null 2>&1 || fallar "La configuración de agentes o la constitución generada están desactualizadas. Ejecuta: make sync"
fi

# 8. El costo de una tarea cerrada no se modifica (specs/**/costos.json con "estado": "cerrado")
for f in $(git diff --cached --name-only --diff-filter=MD -- 'specs/*costos.json'); do
  if git show "HEAD:$f" 2>/dev/null | grep -q '"estado": *"cerrado"' && [ "${APPROVED_COSTS:-}" != "1" ]; then
    fallar "El costo de $(dirname "$f") ya está cerrado y no se modifica. Si dirección técnica lo autoriza: APPROVED_COSTS=1 git commit ..."
  fi
done

# 9. Estado de la funcionalidad (aviso, no bloquea): si cambian spec, plan o tareas, estado.md debería acompañarlos
for dir in $(echo "$STAGED" | grep -E '^specs/.+/(spec|plan|tasks)\.md$' | xargs -r -n1 dirname | sort -u); do
  if [ ! -f "$dir/estado.md" ]; then
    echo "⚠ $dir/ no tiene estado.md. Créalo desde docs/plantillas/estado.md (o pide al orquestador: \"retomemos\")." >&2
  elif ! echo "$STAGED" | grep -qx "$dir/estado.md"; then
    echo "⚠ Cambió spec, plan o tareas en $dir/ sin actualizar estado.md (fase, próximo paso). Agrégalo al commit si corresponde." >&2
  fi
done

if [ "$ERRORES" -ne 0 ]; then
  echo "Commit bloqueado por los controles del proyecto." >&2
  exit 1
fi
exit 0
